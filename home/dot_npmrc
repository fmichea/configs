# Safer defaults, aligns with npm v12 breaking changes
# https://github.blog/changelog/2026-06-09-upcoming-breaking-changes-for-npm-v12/

# Empty allowlist blocks all install-time lifecycle scripts (npm 11.16+)
# Add exceptions per-project: npm pkg set allowedScripts[]=<pkg>
allow-scripts=

# Blocks git-ref dependencies (npm 11.10+)
allow-git=none

# Blocks remote tarball URL dependencies (npm 11.15+)
allow-remote=none
