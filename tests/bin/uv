#!/usr/bin/env python3
"""Stand-in for the uv CLI in tests: logs each call's arguments to $FAKE_UV_CALLS."""

import json
import os
import sys


def main() -> None:
    """Append the arguments to the calls file, one JSON list per line."""
    with open(os.environ["FAKE_UV_CALLS"], "a") as calls:
        calls.write(json.dumps(sys.argv[1:]) + "\n")


if __name__ == "__main__":
    main()
